# HƯỚNG DẪN CẤU HÌNH TỰ ĐỘNG ĐẨY LÊN GITHUB (AUTO-PUSH)
# Đổi tên file này thành .env và điền Personal Access Token của bạn:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hướng dẫn tạo token quyền repo:
# 1. Truy cập: https://github.com/settings/tokens
# 2. Chọn "Generate new token (classic)"
# 3. Đặt tên (Note): QuizAppAutoPush
# 4. Tích chọn quyền: [x] repo (Full control of private repositories)
# 5. Bấm Generate token, sao chép mã và dán vào bên dưới:

GITHUB_TOKEN=

